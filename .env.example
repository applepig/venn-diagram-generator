# Copy to .env and fill in. Two places read it, and .env itself is never committed or rsynced:
#   - on your machine: deploy/deploy.sh sources the repo-root .env, so VENN_DEPLOY_* can live there;
#   - on the deployment host: deploy.sh runs compose with --env-file .env from the deploy directory,
#     so VENN_PUBLIC_HOST / VENN_WATERMARK / VENN_GTM_ID must exist in that host's own .env.

# Required by deploy/compose.yml: the public hostname. Becomes PUBLIC_ORIGIN and the Traefik Host rule.
VENN_PUBLIC_HOST=

# Watermark text drawn at the bottom-right of generated images. Unset or empty = no watermark.
VENN_WATERMARK=

# Google Tag Manager container id. Unset = no GTM snippet (recommended for dev sites).
VENN_GTM_ID=

# Absolute origin used for og:image / og:url. Unset = derived from the request headers.
# deploy/compose.yml sets this from VENN_PUBLIC_HOST; only set it by hand outside compose.
PUBLIC_ORIGIN=

# Required by deploy/deploy.sh: ssh target of the production host (no default).
VENN_DEPLOY_HOST=

# Required by deploy/deploy.sh: directory on that host to rsync this repo into (no default).
VENN_DEPLOY_PATH=

# Required by deploy/compose.dev.yml: hostname of the source-mounted dev site (no default).
VENN_DEV_HOST=

# Port the server listens on. Default 3000.
PORT=3000
