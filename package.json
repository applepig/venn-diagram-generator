{
  "name": "venn-diagram-generator",
  "version": "1.0.0",
  "private": true,
  "description": "WYSIWYG Venn diagram generator — the whole editor state lives in the URL, the server renders the same SVG to PNG and og:image",
  "license": "MIT",
  "author": "Dominic Wu (https://applepig.idv.tw)",
  "homepage": "https://venn.applepig.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applepig/venn-diagram-generator.git"
  },
  "bugs": {
    "url": "https://github.com/applepig/venn-diagram-generator/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "VENN_DEV=1 tsx watch server/index.ts",
    "build": "pnpm build:ui && pnpm build:og && pnpm build:server",
    "build:ui": "vite build",
    "build:og": "tsx scripts/bake-og.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist-server/index.mjs --external:@resvg/resvg-js --external:vite",
    "start": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -f deploy/Dockerfile -t venn-diagram-generator .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
